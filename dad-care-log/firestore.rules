rules_version = '2';

// Rules for the `dad-care-log` Firestore database only. firebase.json binds
// this file to that database id, so the (default) database used by the other
// rks apps is never touched by a deploy of these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // FAMILY ALLOW-LIST: each person's Google account email (lowercase)
    // and the name their entries are saved under. This is the real
    // security boundary: everyone else is refused, even with the link.
    // An entry's "who" must be the name listed here for the account
    // that saves it, so nobody can write under someone else's name.
    //
    // The same emails are in storage.rules; keep the two identical
    // (`npm test` in dad-care-log/tests checks that they match).
    // ---------------------------------------------------------------
    function familyNames() {
      return {
        'adriana@replace-me.invalid': 'Adriana',
        'cremasgto74@gmail.com': 'Alejandro',
        'chavita@replace-me.invalid': 'Chavita',
        'veneegas95@gmail.com': 'Daniel',
        'rickv72@gmail.com': 'Enrique',
        'lorena@replace-me.invalid': 'Lorena',
        'salvador@replace-me.invalid': 'Salvador',
        'teresa@replace-me.invalid': 'Teresa'
      };
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && myEmail() in familyNames();
    }

    // The one person who can delete entries (e.g. test entries). Every
    // deletion must leave a record in /deletions, and entries still can't
    // be edited by anyone.
    function isAdmin() {
      return isFamily() && myEmail() == 'rickv72@gmail.com';
    }

    function optionalString(data, field, maxLen) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLen);
    }

    // A new entry must be well-formed and honestly attributed: the author
    // fields and createdAt come from the request itself, so nobody can
    // backdate an entry's save time or post under someone else's account.
    function isValidNewEntry() {
      let d = request.resource.data;
      return d.keys().hasAll(['when', 'who', 'patient', 'authorEmail', 'authorUid', 'createdAt'])
        && d.keys().hasOnly([
          'when', 'who', 'patient', 'doctor', 'meds', 'next', 'notes',
          'authorEmail', 'authorUid', 'createdAt',
          'photoPath', 'photoKind', 'photoReading', 'photoReadingSource',
          'photoReadingConfirmed', 'correctsId', 'aiFlags', 'aiQuestions'
        ])
        && d.when is timestamp
        && d.who == familyNames()[myEmail()]
        && d.patient is string
        && d.patient.size() > 0
        && d.patient.size() <= 100
        && d.authorEmail == myEmail()
        && d.authorUid == request.auth.uid
        && d.createdAt == request.time
        && optionalString(d, 'doctor', 5000)
        && optionalString(d, 'meds', 5000)
        && optionalString(d, 'next', 5000)
        && optionalString(d, 'notes', 5000)
        && isValidCorrection(d)
        && isValidPhoto(d)
        && isValidAiInfo(d)
        && hasSomeContent(d);
    }

    // Entries can't be edited, so mistakes are fixed with a *new* entry
    // that points at the one it corrects. The original stays as it was.
    function isValidCorrection(d) {
      return !('correctsId' in d)
        || (d.correctsId is string
            && d.correctsId.matches('[A-Za-z0-9]{1,64}')
            && exists(/databases/$(database)/documents/entries/$(d.correctsId)));
    }

    // A photo path must be in the author's own upload folder, or, for a
    // correction, the very same photo the corrected entry points at (so a
    // misread number can be fixed without re-uploading the picture).
    function isAllowedPhotoPath(d) {
      return d.photoPath.matches('dad-care-log/photos/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,100}')
        || ('correctsId' in d
            && d.photoPath == get(/databases/$(database)/documents/entries/$(d.correctsId)).data.get('photoPath', null));
    }

    // Photo fields are all-or-nothing. A reading of the photo can only be
    // saved with photoReadingConfirmed == true: the app sets that only
    // after the person has reviewed (and possibly edited) the text,
    // whether it started as an AI suggestion or was typed by hand.
    function isValidPhoto(d) {
      return (!('photoPath' in d) && !('photoKind' in d) && !('photoReading' in d)
              && !('photoReadingSource' in d) && !('photoReadingConfirmed' in d))
        || ('photoPath' in d
            && d.photoPath is string
            && isAllowedPhotoPath(d)
            && d.photoKind in ['monitor', 'note']
            && (
              (!('photoReading' in d) && !('photoReadingSource' in d) && !('photoReadingConfirmed' in d))
              || (d.photoReading is string
                  && d.photoReading.size() > 0
                  && d.photoReading.size() <= 3000
                  && d.photoReadingSource in ['ai', 'person']
                  && d.photoReadingConfirmed == true)
            ));
    }

    // General AI information about a confirmed reading: the values outside
    // the general range and questions for the nurse or doctor. Saved only
    // together, and only with a photo reading the person confirmed.
    function isValidAiInfo(d) {
      return (!('aiFlags' in d) && !('aiQuestions' in d))
        || ('aiFlags' in d && 'aiQuestions' in d
            && d.aiFlags is list && d.aiFlags.size() <= 20
            && d.aiQuestions is list && d.aiQuestions.size() <= 8
            && 'photoReading' in d
            && d.photoReadingConfirmed == true);
    }

    function hasSomeContent(d) {
      return ('doctor' in d && d.doctor.size() > 0)
        || ('meds' in d && d.meds.size() > 0)
        || ('next' in d && d.next.size() > 0)
        || ('notes' in d && d.notes.size() > 0)
        || ('photoPath' in d);
    }

    match /entries/{entryId} {
      allow read: if isFamily();
      allow create: if isFamily() && isValidNewEntry();
      // Once saved, nobody (including the person who wrote it) can change
      // an entry. Only the admin can remove one, and only in the same
      // write that records the deletion in /deletions.
      allow update: if false;
      allow delete: if isAdmin()
        && existsAfter(/databases/$(database)/documents/deletions/$(entryId));
    }

    // Deletion log: who deleted which entry, when, and why (a reason is
    // required). Written together with the deletion, copied from the entry
    // being deleted, and never changed.
    match /deletions/{entryId} {
      allow read: if isFamily();
      allow create: if isAdmin() && isValidDeletion(entryId);
      allow update, delete: if false;
    }

    function isValidDeletion(entryId) {
      let d = request.resource.data;
      let entryPath = /databases/$(database)/documents/entries/$(entryId);
      let entry = get(entryPath).data;
      return exists(entryPath)
        && !existsAfter(entryPath)
        && d.keys().hasOnly(['deletedBy', 'deletedAt', 'entryWhen', 'entryWho', 'entryPatient', 'reason'])
        && d.reason is string
        && d.reason.trim().size() >= 3
        && d.reason.size() <= 300
        && d.deletedBy == myEmail()
        && d.deletedAt == request.time
        && d.entryWhen == entry.when
        && d.entryWho == entry.who
        && d.entryPatient == entry.get('patient', '');
    }

    // Watch schedule ("Turnos de guardia"). Unlike entries, shifts can be
    // removed (schedules change) by whoever added them or by the admin.
    match /shifts/{shiftId} {
      allow read: if isFamily();
      allow create: if isFamily() && isValidShift();
      allow update: if false;
      allow delete: if isFamily()
        && (resource.data.createdBy == myEmail() || isAdmin());
    }

    function isValidShift() {
      let d = request.resource.data;
      return d.keys().hasAll(['person', 'start', 'end', 'createdBy', 'createdAt'])
        && d.keys().hasOnly(['person', 'start', 'end', 'note', 'createdBy', 'createdAt'])
        && d.person in familyNames().values()
        && d.start is timestamp
        && d.end is timestamp
        && d.end > d.start
        && d.end - d.start <= duration.value(31, 'd')
        && optionalString(d, 'note', 200)
        && d.createdBy == myEmail()
        && d.createdAt == request.time;
    }

    // Lets the page ask "am I the admin?" without the admin's email being
    // in the page itself. No documents are stored here.
    match /admincheck/{id} {
      allow get: if isAdmin();
    }

    // Lets the app find out which name belongs to the signed-in account
    // without the email list ever being sent to the browser: a get of
    // /whoami/<name> is allowed only for that person's own name. No
    // documents are stored here.
    match /whoami/{name} {
      allow get: if isFamily() && familyNames()[myEmail()] == name;
    }

    // Catch-all: deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
